{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 29,
    "patch": 0
  },
  "include": [
    "CMake${hostSystemName}Presets.json"
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "RelWithDebInfo",
      "configurePreset": "relwithdebinfo",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "Release",
      "configurePreset": "release",
      "configuration": "Release"
    }
  ]
}